  "dialogues": [
    {
      "ID": "DL001",
      "Сцена": "SC001",
      "Говорящий": "Дейн",
      "Текст": "Ты ещё можешь отказаться. Я найду способ перевести тебя к писцам.",
      "Эмоция": "Тревога",
      "Следующий ID": "DL002"
    },
    {
      "ID": "DL002",
      "Сцена": "SC001",
      "Говорящий": "Вайолет",
      "Текст": "Моя мать не оставила мне выбора.",
      "Эмоция": "Горечь",
      "Следующий ID": "DL003"
    },
    {
      "ID": "DL003",
      "Сцена": "SC001",
      "Говорящий": "Дейн",
      "Текст": "Тогда хотя бы выслушай меня. На Парапете нельзя торопиться.",
      "Эмоция": "Забота",
      "Следующий ID": "DL004"
    },
    {
      "ID": "DL004",
      "Сцена": "SC001",
      "Говорящий": "Ремарка",
      "Текст": "В нескольких шагах стоит Ксейден. Он замечает Вайолет и задерживает на ней взгляд.",
      "Эмоция": "Нейтрально",
      "Следующий ID": "DL005"
    },
    {
      "ID": "DL005",
      "Сцена": "SC001",
      "Говорящий": "Ксейден",
      "Текст": "Интересно, сколько продержится дочь генерала.",
      "Эмоция": "Насмешка",
      "Следующий ID": "CH001"
    },
    {
      "ID": "DL006A",
      "Сцена": "SC001",
      "Говорящий": "Ксейден",
      "Текст": "Тогда начни с первого шага. Остроты ветер не удержат.",
      "Эмоция": "Интерес",
      "Следующий ID": "DL007"
    },
    {
      "ID": "DL006B",
      "Сцена": "SC001",
      "Говорящий": "Дейн",
      "Текст": "На стыки. Не на середину плит. И смотри на противоположную башню, не вниз.",
      "Эмоция": "Облегчение",
      "Следующий ID": "DL007"
    },
    {
      "ID": "DL006C",
      "Сцена": "SC001",
      "Говорящий": "Вайолет",
      "Текст": "Когда мне понадобится помощь, я попрошу. А пока отойдите.",
      "Эмоция": "Решимость",
      "Следующий ID": "DL007"
    },
    {
      "ID": "DL007",
      "Сцена": "SC001",
      "Говорящий": "Ремарка",
      "Текст": "Дейн протягивает руку к её виску, чтобы убрать мокрую прядь. Вайолет машинально отшатывается. Он замирает, затем прячет ладонь.",
      "Эмоция": "Неловкость",
      "Следующий ID": "DL008"
    },
    {
      "ID": "DL008",
      "Сцена": "SC001",
      "Говорящий": "Дейн",
      "Текст": "Прости. Просто будь осторожна.",
      "Эмоция": "Сдержанная тревога",
      "Следующий ID": "DL009"
    },
    {
      "ID": "DL009",
      "Сцена": "SC001",
      "Говорящий": "Ремарка",
      "Текст": "На шее холодит медальон матери. Вайолет помнит, как его застегнули утром. Но не помнит дорогу от материнского кабинета до башни. За спиной хлопает дверь. Думать об этом уже некогда.",
      "Эмоция": "Тревога",
      "Следующий ID": "SC002"
    },
    {
      "ID": "DL010",
      "Сцена": "SC002",
      "Говорящий": "Ремарка",
      "Текст": "Дождь превращает камень в чёрное стекло. На середине Парапета болтается оборванный сигнальный шнур. Башня напротив кажется слишком далёкой.",
      "Эмоция": "Страх",
      "Следующий ID": "DL011"
    },
    {
      "ID": "DL011",
      "Сцена": "SC002",
      "Говорящий": "Ксейден",
      "Текст": "Когда услышишь треск, не стой на месте.",
      "Эмоция": "Серьёзность",
      "Следующий ID": "DL012"
    },
    {
      "ID": "DL012",
      "Сцена": "SC002",
      "Говорящий": "Вайолет",
      "Текст": "Какой ещё треск?",
      "Эмоция": "Подозрение",
      "Следующий ID": "DL013"
    },
    {
      "ID": "DL013",
      "Сцена": "SC002",
      "Говорящий": "Ремарка",
      "Текст": "Он смотрит не на небо, а на камень у её ног. Дейн окликает её с порога. Порыв ветра заглушает слова.",
      "Эмоция": "Напряжение",
      "Следующий ID": "CH002"
    },
    {
      "ID": "DL014A",
      "Сцена": "SC002",
      "Говорящий": "Ремарка",
      "Текст": "Раз. Два. Пятка к носку. Вода затекает за воротник. Вайолет замечает светлую царапину поперёк следующего шва — слишком прямую для трещины.",
      "Эмоция": "Сосредоточенность",
      "Следующий ID": "SC003"
    },
    {
      "ID": "DL014B",
      "Сцена": "SC002",
      "Говорящий": "Ремарка",
      "Текст": "Ветер на миг слабеет. Вайолет делает три быстрых шага. За спиной с металлическим щелчком что-то проворачивается внутри кладки.",
      "Эмоция": "Испуг",
      "Следующий ID": "SC003"
    },
    {
      "ID": "DL020",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "Плита уходит из-под ноги. Вайолет падает на колено и цепляется за край. В образовавшейся щели торчит вынутый крепёжный штифт с красной нитью.",
      "Эмоция": "Боль",
      "Следующий ID": "DL021"
    },
    {
      "ID": "DL021",
      "Сцена": "SC003",
      "Говорящий": "Вайолет",
      "Текст": "Это не ветер. Кто-то освободил крепление.",
      "Эмоция": "Ужас",
      "Следующий ID": "DL022"
    },
    {
      "ID": "DL022",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "До целого камня можно дотянуться. До штифта тоже. Но свободная рука только одна.",
      "Эмоция": "Напряжение",
      "Следующий ID": "CH003"
    },
    {
      "ID": "DL023A",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "Вайолет заводит локоть за край и выдёргивает штифт. Острый металл рассекает ладонь. Она прячет улику за пояс, подтягивается и перекатывается на целую плиту.",
      "Эмоция": "Боль",
      "Следующий ID": "DL024"
    },
    {
      "ID": "DL023B",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "Она вцепляется обеими руками в стык и вытягивает себя на камень. Штифт исчезает в провале. Внизу ничего не слышно.",
      "Эмоция": "Потрясение",
      "Следующий ID": "DL024"
    },
    {
      "ID": "DL024",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "Остаток пути сжимается до одного правила: следующий шаг. Когда Вайолет достигает башни, ноги подкашиваются уже на безопасном полу.",
      "Эмоция": "Облегчение",
      "Следующий ID": "DL025"
    },
    {
      "ID": "DL025",
      "Сцена": "SC003",
      "Говорящий": "Ремарка",
      "Текст": "Ксейден, наблюдавший с внешней лестницы, входит через боковую дверь. Дейн прибывает из исходной башни по внутреннему переходу, недоступному поступающим. Ни один из них не поздравляет её.",
      "Эмоция": "Настороженность",
      "Следующий ID": "SC004"
    },
    {
      "ID": "DL030",
      "Сцена": "SC004",
      "Говорящий": "Дейн",
      "Текст": "Я слышал обвал. Покажи руки.",
      "Эмоция": "Тревога",
      "Следующий ID": "DL031"
    },
    {
      "ID": "DL031",
      "Сцена": "SC004",
      "Говорящий": "Ксейден",
      "Текст": "Сначала спроси, почему камень обвалился именно под ней.",
