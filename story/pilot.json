      "Следующий ID": "DL033"
    },
    {
      "ID": "DL033",
      "Сцена": "SC004",
      "Говорящий": "Ксейден",
      "Текст": "Я видел, как перед испытанием туда спускался человек с инструментами. Решил, что чинят кладку. Потом он ушёл со штифтом в руке.",
      "Эмоция": "Сдержанная вина",
      "Следующий ID": "DL034"
    },
    {
      "ID": "DL034",
      "Сцена": "SC004",
      "Говорящий": "Дейн",
      "Текст": "Нужно составить рапорт. Сейчас.",
      "Эмоция": "Настойчивость",
      "Следующий ID": "CH004"
    },
    {
      "ID": "DL035D",
      "Сцена": "SC004",
      "Говорящий": "Дейн",
      "Текст": "Без твоего согласия я ничего ей не передам. Но ты остаёшься рядом со мной.",
      "Эмоция": "Забота",
      "Следующий ID": "DL036D"
    },
    {
      "ID": "DL036D",
      "Сцена": "SC004",
      "Говорящий": "Вайолет",
      "Текст": "Рядом — да. Под твоим надзором — нет.",
